{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Disactivity Steam",
  "version": "1.2.0",
  "identifier": "com.k1tsune12.disactivitysteam",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Disactivity Steam",
        "width": 650,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "windowEffects": {
          "effects": ["mica"]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "K1tsune12",
    "copyright": "Copyright © 2026 holasoyender, K1tsune12",
    "shortDescription": "Discord Activity Simulator",
    "longDescription": "Disactivity Steam simulates game activity on Discord by running fake game processes that Discord can detect, including games that only Discord recognizes through the Steam library.",
    "category": "Utility",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/K1tsune12/disactivity-steam/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGRTY2QTUyREJGMjA2OTEKUldTUkJ2TGJVbXJtUCtNTFR1dThaMDNPUXRJRkkybWxJYktGL01iYndCcTZCSGlWOHppTEZ2NWEK"
    }
  }
}
